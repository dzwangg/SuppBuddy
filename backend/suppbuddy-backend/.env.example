# Copy to .env and fill in.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5
# Server-side web search for the agent. Blank disables.
WEB_SEARCH_TOOL_TYPE=web_search_20250305

# Optional: higher openFDA rate limits (https://open.fda.gov/apis/authentication/)
OPENFDA_API_KEY=

# 1 = skip all network lookups (bad venue wifi, tests)
EVIDENCE_OFFLINE=0

# Default is SQLite in data/. For Supabase/Postgres: postgresql+psycopg://user:pass@host/db
# DATABASE_URL=

# Sensor ceilings. Set from the gain/integration time the hardware team locks in.
TCS_SATURATION=65000
TSL_SATURATION=65000
PROTOCOL_VERSION=v1
