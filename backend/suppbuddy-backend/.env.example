# Copy to .env and fill in.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5
# Server-side web search for the agent. Blank disables.
WEB_SEARCH_TOOL_TYPE=web_search_20260209

# Optional: higher openFDA rate limits (https://open.fda.gov/apis/authentication/)
OPENFDA_API_KEY=

# 1 = skip all network lookups (bad venue wifi, tests)
EVIDENCE_OFFLINE=0

# Default is SQLite in data/. For Supabase/Postgres: postgresql+psycopg://user:pass@host/db
# DATABASE_URL=

# Sensor ceilings for the firmware's integration times (see app/config.py).
# TCS34725 at 50 ms tops out at 21,504; TSL2591 at 100 ms tops out at 37,888.
TCS_SATURATION=21000
TSL_SATURATION=37000
PROTOCOL_VERSION=v1
