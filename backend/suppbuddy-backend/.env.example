# Copy to .env and fill in.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5
# Server-side web search for the agent. Blank disables.
WEB_SEARCH_TOOL_TYPE=web_search_20260209

# Optional: higher openFDA rate limits (https://open.fda.gov/apis/authentication/)
OPENFDA_API_KEY=

# 1 = skip all network lookups (bad venue wifi, tests)
EVIDENCE_OFFLINE=0

# Shared secret the app sends as "Authorization: Bearer ..." (Settings > API token). Leave blank only while
# the server is reachable from your own machine alone; set it before ngrok/Railway.
API_TOKEN=

# Default is SQLite in data/. For Supabase/Postgres: postgresql+psycopg://user:pass@host/db
# DATABASE_URL=

# Fingerprints are kept per protocol so data from different rigs or sample preps never mix.
# v3 = firmware/SupplementOpticalTester (dark + white/red/green/blue cycle).
PROTOCOL_VERSION=v3

# Reference sensor settings (firmware Config.h). Scans reporting other settings get a warning.
# REF_TCS_GAIN=4
# REF_TCS_INTEGRATION_MS=50
# REF_TSL_GAIN=25
# REF_TSL_INTEGRATION_MS=100

# Saturation limits are derived from the integration time each scan reports
# (TCS34725 at 50 ms: 21,504 max; TSL2591 at 100 ms: 37,888 max). Set these only to override.
# TCS_SATURATION=21000
# TSL_SATURATION=37000

# Standard sample prep: this much powder in this much water. Scans that report a different
# mass/volume are rescaled to it (between 0.5x and 2x).
# SAMPLE_MASS_MG=500
# SAMPLE_VOLUME_ML=50
